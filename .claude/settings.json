{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "mvn -q -DskipTests compile",
        "statusMessage": "Compiling DocGuard...",
        "timeout": 120
      }]
    }]
  },
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "PowerShell(mvn *)",
      "Bash(git status --short --branch)",
      "Bash(git status --short)",
      "Bash(git branch --show-current)",
      "Bash(git for-each-ref refs/heads)",
      "Bash(git ls-remote --heads origin)",
      "Bash(git fetch origin main)",
      "Bash(git diff --stat origin/main)",
      "Bash(git diff origin/main)",
      "Bash(git diff --stat origin/main...HEAD)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git log --oneline origin/main..HEAD)",
      "Bash(gh auth status)",
      "Bash(gh pr list --head *)",
      "Bash(gh pr checks *)",
      "PowerShell(git status --short --branch)",
      "PowerShell(git status --short)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git for-each-ref refs/heads)",
      "PowerShell(git ls-remote --heads origin)",
      "PowerShell(git fetch origin main)",
      "PowerShell(git diff --stat origin/main)",
      "PowerShell(git diff origin/main)",
      "PowerShell(git diff --stat origin/main...HEAD)",
      "PowerShell(git diff origin/main...HEAD)",
      "PowerShell(git log --oneline origin/main..HEAD)",
      "PowerShell(gh auth status)",
      "PowerShell(gh pr list --head *)",
      "PowerShell(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * :*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git -* push*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(gh -* pr merge*)",
      "Bash(gh -* pr ready*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push -d*)",
      "PowerShell(git push * -d*)",
      "PowerShell(git push * :*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push * --mirror*)",
      "PowerShell(git push --prune*)",
      "PowerShell(git push * --prune*)",
      "PowerShell(git push --no-verify*)",
      "PowerShell(git push * --no-verify*)",
      "PowerShell(git push * main*)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *:refs/heads/main*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit * --no-verify)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n)",
      "PowerShell(git -* push*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh -* pr merge*)",
      "PowerShell(gh -* pr ready*)"
    ]
  }
}
